{
  "name": "@scaffold/scaffold",
  "version": "0.0.1",
  "exports": "./mod.ts",

  "lock": false,
  "compilerOptions": {
    "allowJs": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "strict": true,
    "lib": [
      "dom",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "lint": {
    "exclude": [
      "avro",
      "dist",
      "tests/avro"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo",
        "camelCase",
        "default-param-last",
        "eqeqeq",
        "guard-for-in",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-external-import",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "prefer-ascii",
        "single-var-declarator"
      ],
      "exclude": []
    }
  },
  "fmt": {
    "exclude": [
      "README.md",
      "avro",
      "dist"
    ],
    "singleQuote": true
  },
  "tasks": {
    "dev": "export DENO_FLAGS=--watch ; deno task fmt & deno task run-server",
    "fmt": "deno fmt $DENO_FLAGS",
    "lint": "deno lint $DENO_FLAGS",
    "bundle-js": "deno bundle $DENO_FLAGS --check mod.ts dist/index.js",
    "bundle-worker": "deno bundle $DENO_FLAGS --check src/worker/worker.ts dist/worker.js",
    "run-server": "deno run $DENO_FLAGS --check --allow-all --unstable scripts/server.ts",
    "run-signaling-server": "deno run $DENO_FLAGS --check --allow-all --unstable scripts/signalingServer.ts",
    "test": "deno test $DENO_FLAGS --allow-all --seed=123 --trace-ops tests/",
    "test-avro": "# mocha --ui tdd --reporter dot"
  },
  "imports": {
    "$std/": "https://deno.land/std@0.217.0/",
    "dnt": "https://deno.land/x/dnt@0.39.0/mod.ts"
  }
}
