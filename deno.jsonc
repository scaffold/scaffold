{
  "importMap": "import_map.json",
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "jsx": "react"
  },
  "lint": {},
  "fmt": {
    "files": {
      "exclude": ["README.md", "jsoncons"]
    },
    "options": {
      "singleQuote": true
    }
  },
  "tasks": {
    "fmt": "deno fmt --options-single-quote --watch",
    "serve-ui": "deno run --allow-all https://deno.land/x/packup/cli.ts index.html --import-map=import_map.json",
    "serve-ws": "deno run --check --allow-all --watch server/main.ts",
    "test-avro": "# mocha --ui tdd --reporter dot"
  }
}
