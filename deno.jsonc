{
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext", // These are only used in bundling
    "module": "esnext", // These are only used in bundling
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "jsx": "react"
  },
  "lint": {},
  "format": {
    "options": {
      "singleQuote": true
    }
  }
}
