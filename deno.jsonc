{
  "importMap": "import_map.json",
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "jsx": "react"
  },
  "lint": {},
  "fmt": {
    "files": {
      "exclude": ["README.md", "build/"]
    },
    "options": {
      "singleQuote": true
    }
  },
  "tasks": {
    "fmt": "deno fmt --options-single-quote --watch",
    "build": "deno bundle --check --config=deno.jsonc --watch app.tsx build/index.js",
    "serve": "deno run --check --allow-all --watch server/main.ts"
  }
}
